# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# MONGO_URI: MongoDB connection string (e.g. mongodb+srv://<username>:<password>@cluster0.mongodb.net/myblog?retryWrites=true&w=majority)
MONGO_URI=""

# JWT_SECRET: Secret used for signing authentication JSON Web Tokens
JWT_SECRET="my_super_secret_jwt_key_example"
